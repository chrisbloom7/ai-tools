{
  "permissions": {
    "allow": [
      "Bash(jq empty *)",
      "Bash(claude plugin validate *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-manifest.sh"
          }
        ]
      }
    ]
  }
}
